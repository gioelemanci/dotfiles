/* ==========================================================================
   MINIMAL LAUNCHER WITH SIDEBAR AND PYWAL ACCENTS
   ========================================================================== */

/* 1. Import dynamic colors generated by Pywal (if available) */
@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    /* 2. Force backgrounds to stay neutral and dark, overriding Pywal backgrounds */
    bg-base:            #1e1e2e; /* Main background (dark neutral) */
    bg-alt:             #313244; /* Secondary background (for inputs and buttons) */
    text-base:          #cdd6f4; /* Neutral text color */
    
    /* 3. Fetch the accent color from Pywal. 
       Fallback to a bright blue if Pywal hasn't loaded yet */
    accent:             var(selected-normal-background, #89b4fa);

    /* Global invisible settings */
    background-color:   transparent;
    text-color:         @text-base;
    margin:             0;
    padding:            0;
}

/* ==========================================================================
   MAIN WINDOW
   ========================================================================== */
window {
    width:              45em;
    background-color:   @bg-base;
    border:             2px;
    border-color:       @accent; /* Dynamically colored border */
    border-radius:      15px;
    padding:            15px;
}

/* Master container (divides top and bottom) */
mainbox {
    orientation:        vertical;
    spacing:            15px;
    children:           [ "inputbar", "bottom-row" ];
}

/* ==========================================================================
   TOP: SEARCH BAR
   ========================================================================== */
inputbar {
    background-color:   @bg-alt;
    border-radius:      10px;
    padding:            12px 15px;
    spacing:            10px;
    children:           [ "prompt", "entry" ];
}

prompt {
    text-color:         @accent; /* Colored search icon */
    font:               "JetBrainsMono Nerd Font 14";
    /* Note: if you want a custom search icon instead of the mode name, uncomment below */
    /* str:             ""; */
}

entry {
    placeholder:        "Search...";
    placeholder-color:  #7f849c;
    text-color:         @text-base;
    vertical-align:     0.5;
}

/* ==========================================================================
   BOTTOM: HORIZONTAL CONTAINER (Sidebar + List)
   ========================================================================== */
bottom-row {
    orientation:        horizontal;
    spacing:            15px;
    children:           [ "mode-switcher", "listview" ];
}

/* ---- Left: Modes Sidebar (Icons only) ---- */
mode-switcher {
    orientation:        vertical;
    spacing:            10px;
    width:              4em;      /* Narrow width since it holds only icons */
    expand:             false;    /* Prevent it from stretching horizontally */
}

button {
    padding:            10px;
    border-radius:      10px;
    background-color:   @bg-alt;
    text-color:         @text-base;
    cursor:             pointer;
    font:               "JetBrainsMono Nerd Font 14"; /* Slightly larger for icons */
}

button selected {
    background-color:   @accent;  /* Pywal color when tab is selected */
    text-color:         @bg-base; /* Dark text for contrast against accent */
}

/* ---- Right: App List ---- */
listview {
    expand:             true;     /* Take up all remaining space */
    columns:            1;
    lines:              8;
    spacing:            5px;
    scrollbar:          false;
    cycle:              false;
}

element {
    padding:            10px 15px;
    border-radius:      10px;
    spacing:            15px;
    cursor:             pointer;
}

element normal.normal, element alternate.normal {
    background-color:   transparent;
}

element selected.normal {
    background-color:   @accent;  /* Pywal color on the selected app */
    text-color:         @bg-base; /* Dark text for contrast */
}

element-icon {
    size:               24px;
}

element-text {
    vertical-align:     0.5;
    text-color:         inherit;
}
