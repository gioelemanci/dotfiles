/* ---- Window ---- */
window {
    height:                      27em;
    width:                       45em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      2px;
    border-color:                @border-colour;
    border-radius:               15px;
    background-color:            @background;
}

/* ---- Main Container ---- */
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
    background-color:            transparent;
}

/* ---- Left Side (Image & Controls) ---- */
imagebox {
    padding:                     20px;
    background-color:            transparent;
    background-image:            @current-image; 
    orientation:                 vertical;
    children:                    [ "inputbar", "dummy", "mode-switcher" ];
    border-radius:               15px 0px 0px 15px;
}

/* ---- Right Side (List) ---- */
listbox {
    padding:                     20px;
    spacing:                     0em;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "listview" ];
}

/* ---- Spacer ---- */
dummy {
    background-color:            transparent;
}

/* ---- Input Bar ---- */
inputbar {
    enabled:                     true;
    margin:                      0em 0em 1em 0em; 
    children:                    [ "textbox-prompt-colon", "entry" ];
    border-radius:               10px;
    background-color:            @background-alt;
    padding:                     10px;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     0 10px 0 0;
    text-color:                  @foreground;
    background-color:            transparent;
    font:                        "JetBrainsMono Nerd Font 16";
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
}

/* ---- Mode Switcher ---- */
mode-switcher {
    orientation:                 horizontal;
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
}

button {
    padding:                     10px;
    border-radius:               10px;
    cursor:                      pointer;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

button selected {
    background-color:            @selected;
    text-color:                  @background;
}

/* ---- Listview ---- */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
    border:                      0px;
}

/* ---- Elements ---- */
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               10px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @foreground;
}

/* -- Normal State (Unselected) -- */
element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

/* -- Selected State -- */
element selected.normal {
    background-color:            @selected;
    text-color:                  @background;
}

element selected.active {
    background-color:            @selected;
    text-color:                  @background;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @background;
}

/* -- Active/Urgent States (Unselected) -- */
element normal.active {
    background-color:            transparent;
    text-color:                  @active;
}

element alternate.active {
    background-color:            transparent;
    text-color:                  @active;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

element alternate.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

/* -- Icons & Text -- */
element-icon {
    size:                        24px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    vertical-align:              0.5;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
