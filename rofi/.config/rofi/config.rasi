/* ---- General Configuration ---- */
configuration {
    modi:                       "drun,run,filebrowser";
    font:                       "JetBrainsMono Nerd Font 11";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    drun-display-format:        "{name}";
    hover-select:               false;
    scroll-method:              1;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

/* ---- Imports ---- */
/* 1. Colors */
@import "~/.config/rofi/source/colors.rasi"

/* 2. Dynamic Wallpaper (Generated by your script) */
@import "~/.config/rofi/current_wallpaper.rasi"

/* 3. Layout Structure */
@import "~/.config/rofi/source/layout.rasi"
