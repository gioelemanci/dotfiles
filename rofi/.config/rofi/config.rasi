/* ==========================================================================
   ROFI CORE CONFIGURATION (Logic & Icons Only)
   ========================================================================== */
configuration {
    modi:                       "drun,run,filebrowser,window";
    font:                       "JetBrainsMono Nerd Font 11";
    show-icons:                 true;
    
    /* Icon-only mode labels for the sidebar */
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    
    drun-display-format:        "{name}";
    hover-select:               true;
    scroll-method:              0;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}
