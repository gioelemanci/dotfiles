{ 
  // ===== LEFT MODULES =====
"hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
},

  "mpris": {
    "format": "{status_icon} {title} <small>({position}/{length})</small>",
    "format-paused": "{status_icon} <i>{title}</i> <small>({position}/{length})</small>",
    "format-stopped": "",
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "max-length": 45
  },
  
  // ===== CENTER MODULES =====
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%d %B}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "none",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
    
  // ===== RIGHT MODULES =====

  "group/tray-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/arrow",
      "tray"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/arrow": {
    "format": "",
    "tooltip": false
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱡏",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "group/connections-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/connections",
      "network",
      "bluetooth"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "connections-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/connections": {
    "format": "󰖩",
    "tooltip": false
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "󰂲 Off",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} 󰥉 {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  
 "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰤭  Offline",
    "format-alt": "󰤨  {signalStrength}% | 󰩟 {ipaddr}/{cidr}",
    "tooltip-format": "󰤨  {essid}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
    "format-alt-click": "click-right",
    "on-click": "~/.config/ronema/ronema",
    "on-click-middle": "nm-connection-editor"
  }, 


"battery": {
  "states": {
    "warning": 30,
    "critical": 15
  },
  "format": "{icon} {capacity}",
  "format-charging": "⚡ {capacity}",
  "format-plugged": "⚡ {capacity}",
  "format-alt": "{icon} {time}",
  "format-icons": [
    "৹ ৹ ৹ ৹ ৹",  // 0–19%
    "▋৹ ৹ ৹ ৹",  // 20–39%
    "▋▋৹ ৹ ৹",  // 40–59%
    "▋▋▋৹ ৹",  // 60–79%
    "▋▋▋▋৹",  // 80–99%
    "▋▋▋▋▋"   // 100%
  ],
  "on-click-right": "kitty battop"
},
 
"group/hardware-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/system",
      "cpu",
      "memory"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "hardware-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/system": {
    "format": "",
    "tooltip": false
  },

  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty --class system-monitor -e btop",
    "tooltip": false
  },

  "memory": {
    "format": " {}%",
    "on-click": "kitty --class system-monitor -e htop",
    "tooltip": false
  },

}
