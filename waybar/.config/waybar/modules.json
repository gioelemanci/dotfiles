{ 
  // ===== LEFT MODULES =====
"hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "persistent-workspaces": {
      "*": 5
    }
},

  "mpris": {
    "format": "{status_icon} {title} <small>({length})</small>",
    "format-paused": "{status_icon} <i>{title}</i> <small>({position}/{length})</small>",
    "format-stopped": "",
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "max-length": 45
  },
  
  // ===== CENTER MODULES =====
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%d %B}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "none",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
    
  // ===== RIGHT MODULES =====

  "group/tray-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/arrow",
      "tray"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/arrow": {
    "format": "",
    "tooltip": false
  },

"group/audio-drawer": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio#icon",
      "pulseaudio#text"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "audio-drawer",
      "transition-left-to-right": false
    }
  },

  "pulseaudio#icon": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱡏",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "reverse-scrolling": true,
    "tooltip": false
  },

  "pulseaudio#text": {
    "format": "{volume}",
    "format-muted": "0",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "reverse-scrolling": true,
    "tooltip": false
  },

  "group/connections-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/connections",
      "network",
      "bluetooth"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "connections-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/connections": {
    "format": "󰖩",
    "tooltip": false
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "󰂲 Off",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} 󰥉 {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  
 "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰤭  Offline",
    "format-alt": "󰤨  {signalStrength}% | 󰩟 {ipaddr}/{cidr}",
    "tooltip-format": "󰤨  {essid}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
    "format-alt-click": "click-right",
"on-click": "kitty --class floating-tui -o remember_window_size=no -o initial_window_width=850 -o initial_window_height=550 -e nmtui-fancy.sh",
    "on-click-middle": "nm-connection-editor"
  }, 

"battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰁹 {capacity}",
    "format-charging": "⚡ {capacity}",
    "format-plugged": "⚡ {capacity}",
    "on-click": "kitty --class floating-tui -o remember_window_size=no -o initial_window_width=850 -o initial_window_height=550 -e battop"
  },

"group/hardware-drawer": {
    "orientation": "horizontal",
    "modules": [
      "custom/system",
      "custom/updates",
      "cpu",
      "memory"
    ],
    "drawer": {
      "transition-duration": 300,
      "children-class": "hardware-drawer",
      "transition-left-to-right": false
    }
  },

  "custom/system": {
    "format": "",
    "tooltip": false
  },

  "custom/updates": {
    "format": "󰏔 {}",
    "exec": ".local/bin/check-updates.sh",
    "return-type": "json",
    "interval": 600,
    "on-click": "kitty --class floating-tui -o remember_window_size=no -o initial_window_width=850 -o initial_window_height=550 -e .local/bin/arch-maintenance.sh",
    "tooltip": true
  },

  "cpu": {
    "format": " {usage}",
    "on-click": "kitty --class floating-tui -o remember_window_size=no -o initial_window_width=850 -o initial_window_height=550 -e btop",
    "tooltip": false
  },

  "memory": {
    "format": " {}",
    "on-click": "kitty --class floating-tui -o remember_window_size=no -o initial_window_width=850 -o initial_window_height=550 -e htop",
    "tooltip": false
  },

}
