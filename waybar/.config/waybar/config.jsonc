  {
  // General Settings

  // Position
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 4,
  
  // Load modules
  "include": ["~/.config/waybar/modules.json"],

  // Modules layout
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "battery",
    "custom/power"
  ],

  // Groups...
}
